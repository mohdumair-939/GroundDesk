# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string from Neon or Supabase (with pgvector enabled).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# LLM + embeddings (Sprint 2). Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional backup LLM provider (https://console.groq.com)
GROQ_API_KEY=

# AI providers: gemini | groq | mock. mock needs no key (demo/offline fallback).
# If the primary LLM fails, the other hosted provider is tried when its key is set.
LLM_PROVIDER=gemini
# gemini | mock. Re-run `python -m app.ingest` after changing this.
EMBEDDING_PROVIDER=gemini
# Best KB match below this = "no reliable solution". With EMBEDDING_PROVIDER=mock use 0.40.
SIMILARITY_THRESHOLD=0.70
